# Public Convex deployment URL, for example https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL used by Better Auth, for example https://your-deployment.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public application URL (production domain or tunnel); used by the Telegram mini app.
NEXT_PUBLIC_APP_URL=

# Telegram bot token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID that receives the receptionist alert whenever a new order is submitted.
# Falls back to TELEGRAM_OWNER_CHAT_ID if unset for backwards compatibility.
TELEGRAM_RECEPTION_CHAT_ID=

# Chat ID that receives Telegram new-order notifications (legacy alias for
# TELEGRAM_RECEPTION_CHAT_ID, kept for backwards compatibility).
TELEGRAM_OWNER_CHAT_ID=

# Chat ID that receives owner login security alerts (send /start to the bot first).
TELEGRAM_ALERT_CHAT_ID=

# Optional shared secret Telegram sends on every webhook request (header x-telegram-bot-api-secret-token).
TELEGRAM_WEBHOOK_SECRET=
