# Public Convex deployment URL, for example https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL used by Better Auth, for example https://your-deployment.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional Google OAuth credentials for sign-in and authenticated account linking.
# Configure these in Convex deployment environment variables; never commit values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
