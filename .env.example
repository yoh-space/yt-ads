# Public Convex deployment URL, for example https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL used by Better Auth, for example https://your-deployment.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public application URL (production domain or tunnel); used by the Telegram mini app.
NEXT_PUBLIC_APP_URL=

# Telegram bot token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=
